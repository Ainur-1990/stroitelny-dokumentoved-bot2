{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "construction-doc-bot": {
      "root": ".",
      "entrypoint": "app:api"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "construction-doc-bot"
      }
    }
  ]
}
