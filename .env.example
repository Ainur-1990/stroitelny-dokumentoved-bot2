TELEGRAM_BOT_TOKEN=replace_with_botfather_token
WEBHOOK_SECRET=replace_with_random_32_char_secret
PUBLIC_BASE_URL=https://your-service.example.com
POLLING_MODE=false
PORT=8000
LOG_LEVEL=INFO
BYOK_ENCRYPTION_KEY=generate_a-fernet-key-with-python
# Telegram ID администраторов через запятую: уведомления о заявках + команда /leads
ADMIN_USER_IDS=
# ИИ сервиса по умолчанию (для всех пользователей). OpenAI-compatible совместим
# с большинством шлюзов; поддержан также openai / anthropic / google.
AI_PROVIDER=openai_compatible
AI_MODEL=
AI_ENDPOINT=
AI_API_KEY=
# DB_PATH=/var/data/bot.sqlite3 when using a persistent disk
# Optional future integration for services outside Telegram:
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
